<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post</title>
    <import src="./comp/navbar.heml" as="navbar" />
</head>

<body>
    <navbar post="{postState}" />

    <var name="idParam" value="{() => {
        return new URLSearchParams(window.location.search).get('id');
    }}" />
    <var name="postState" value="{{ status: 0, data: null }}" />

    <if condition="{idParam.value() === null}">
        Id Not Found!
    </if>
    <else>
        <match value="{postState.value}">
            <arm expr="{{status: 0}}">
                Loading...!
            </arm>
            <arm expr="{{status: 200}}">
                <h2>
                    <value name="{postState.value.data.title}"/>
                </h2>
                <p>
                    <value name="{postState.value.data.post}"/>
                </p>
            </arm>
            <arm expr="{{status: 404}}">
                Not Found!
            </arm>
            <arm expr="{{status: 500}}">
                Internal Server Error
            </arm>
            <arm default>
                Unexpected Error
            </arm>
        </match>
    </else>

    <script>
        const ID_PARAM = "id";
        const urlParams = new URLSearchParams(window.location.search);
        const id = urlParams.get(ID_PARAM);

        const loadPost = async () => {
            try {
                const resp = await fetch(`http://localhost:3000/api/v1/posts/${id}`);
                const data = await resp.json();
                postState.value = { status: resp.status, data: data };
            } catch (error) {
                console.error(error);
                postState.value = { status: 500, data: null };
            }
        };

        if (id !== null) {
            loadPost();
        }
    </script>
</body>

</html>